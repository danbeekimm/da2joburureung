#!/bin/bash
# ==============================================================
# da2jobu demo bootstrap (Amazon Linux 2023, t3.medium / 4GB)
#  - DB는 RDS, 이미지는 ECR(CI가 push) → EC2는 pull 만
#  - 로그: /var/log/user-data.log
# ==============================================================
set -euxo pipefail
exec > /var/log/user-data.log 2>&1
echo ">>> bootstrap start: $(date)"

REGION="${aws_region}"
DB_HOST="${db_host}"
DB_USER="${db_username}"
ECR_REGISTRY="${ecr_registry}"

# 1) 스왑 2GB (RDS로 DB가 빠져 여유가 생겼지만 안전망 유지)
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi
sysctl -w vm.swappiness=60

# 2) Docker / git / postgresql 클라이언트 설치 (aws-cli v2는 AL2023 기본 포함)
dnf update -y
dnf install -y docker git postgresql15
systemctl enable --now docker
usermod -aG docker ec2-user

# 3) Docker Compose v2 플러그인
mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version

# 4) 소스 클론
cd /opt
rm -rf app
git clone --depth 1 --branch ${repo_branch} ${repo_url} app
cd /opt/app
mkdir -p logs

# 5) .env 생성 (DB_HOST=RDS, ECR 정보 포함. 비밀값은 Terraform 변수에서 주입)
set +x # 시크릿이 로그에 남지 않도록 -x 잠시 해제
cat > /opt/app/.env <<'ENVEOF'
POSTGRES_USER=${db_username}
POSTGRES_PASSWORD=${postgres_password}
DB_HOST=${db_host}
USER_DB=userdb
NOTIFICATION_DB=notificationdb
DELIVERY_DB=deliverydb
COMPANY_DB=companydb
HUB_DB=hubdb
PRODUCT_DB=productdb
ORDER_DB=orderdb
AI_DB=aidb
EUREKA_SERVER_PORT=8761
GATEWAY_SERVER_PORT=8080
USER_SERVER_PORT=8082
HUB_SERVER_PORT=8084
HUB_PATH_SERVER_PORT=8086
COMPANY_SERVER_PORT=8088
PRODUCT_SERVER_PORT=8090
ORDER_SERVER_PORT=8092
DELIVERY_SERVER_PORT=8094
NOTIFICATION_SERVER_PORT=8100
AI_SERVER_PORT=8200
ZOOKEEPER_CLIENT_PORT=2181
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_PORT=8071
SPRING_DATA_REDIS_PORT=6379
JWT_SECRET=${jwt_secret}
JWT_ACCESS_TOKEN_EXPIRATION=3600000
KAKAO_API_KEY=${kakao_api_key}
INTERNAL_TOKEN=${internal_token}
INTERNAL_API_SECRET=${internal_api_secret}
ECR_REGISTRY=${ecr_registry}
ECR_REPO_PREFIX=${ecr_repo_prefix}
IMAGE_TAG=${image_tag}
CLOUDFLARE_TUNNEL_TOKEN=${cf_tunnel_token}
ENVEOF

# 6) RDS에 서비스별 DB 8개 생성 (멱등). RDS는 init 스크립트를 안 돌리므로 여기서 처리.
export PGPASSWORD='${postgres_password}'

echo ">>> waiting for RDS to accept connections"
for i in $(seq 1 30); do
  if pg_isready -h "$DB_HOST" -U "$DB_USER" -d postgres -t 5; then break; fi
  echo "   RDS not ready yet ($i/30)"; sleep 10
done

for db in userdb notificationdb deliverydb companydb hubdb productdb orderdb aidb; do
  if ! psql -h "$DB_HOST" -U "$DB_USER" -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='$db'" | grep -q 1; then
    echo ">>> creating database $db"
    psql -h "$DB_HOST" -U "$DB_USER" -d postgres -c "CREATE DATABASE \"$db\""
  fi
done
unset PGPASSWORD
set -x # 로그 다시 켬

# 7) 재실행 가능한 배포 스크립트 작성 (CI가 새 이미지를 push 할 때마다, 또는 start 후 갱신 시 재실행)
cat > /opt/app/deploy.sh <<DEPLOYEOF
#!/bin/bash
set -euo pipefail
cd /opt/app
REGION="$REGION"
ECR_REGISTRY="$ECR_REGISTRY"
APP="eureka-server gateway-service user-service product-service order-service company-service delivery-service hub-service hubpath-service"
INFRA="zookeeper kafka redis postgres"
COMPOSE="docker compose -f docker-compose.yml -f docker-compose.deploy.yml"

# Cloudflare 터널 토큰이 .env 에 있으면 cloudflared 도 함께 기동
EDGE=""
if grep -Eq '^CLOUDFLARE_TUNNEL_TOKEN=.+' .env; then EDGE="cloudflared"; fi

echo ">>> ECR login"
aws ecr get-login-password --region "\$REGION" | docker login --username AWS --password-stdin "\$ECR_REGISTRY"

echo ">>> pull images"
\$COMPOSE pull \$APP \$INFRA \$EDGE

echo ">>> up (no build)"
\$COMPOSE up -d --no-build \$APP \$EDGE
DEPLOYEOF
chmod +x /opt/app/deploy.sh

# 8) 최초 기동 시도 (CI가 아직 이미지를 안 올렸으면 실패할 수 있음 → 무시하고 진행)
#    이미지가 ECR에 올라온 뒤 'sudo /opt/app/deploy.sh' 를 다시 실행하면 됨.
/opt/app/deploy.sh || echo ">>> deploy 실패(이미지 미존재 가능). CI 빌드 후 'sudo /opt/app/deploy.sh' 재실행하세요."

echo ">>> bootstrap done: $(date)"
echo ">>> NEXT: 1) GitHub Actions 빌드 완료 확인  2) sudo /opt/app/deploy.sh  3) hubpath Swagger 에서 POST /api/internal/hub-paths 로 허브경로 시드"
